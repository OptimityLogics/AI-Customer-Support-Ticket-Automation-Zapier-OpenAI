    "382672800": {
      "id": 382672800,
      "account_id": 28817829,
      "customuser_id": 28984783,
      "paused": true,
      "type_of": "write",
      "params": {
        "api_branch_name": "",
        "authentication_id": "0",
        "provider_id": "openai",
        "instructions": "You are a customer support ticket classifier and router. Analyze the incoming support ticket and perform the following:\n\n1. **Classify the category** (use the provided category, but validate it):\n   - billing: payment issues, subscription, billing inquiries\n   - technical: bugs, errors, feature requests, performance\n   - account: login, password, profile, permissions\n   - general: feedback, questions, other\n\n2. **Determine priority**:\n   - Urgent: payment failure, security issue, account blocked, service unavailable\n   - High: premium customer with an important issue OR repeated issue attempts\n   - Medium: normal support issue\n   - Low: general question or feedback\n\n3. **Assign team based on category**:\n   - billing → Finance Support\n   - technical → Technical Support\n   - account → Account Support\n   - general → Customer Support\n\n4. **Return as JSON** with these fields:\n   {\n     \"category\": \"billing|technical|account|general\",\n     \"priority\": \"Urgent|High|Medium|Low\",\n     \"assigned_team\": \"Team Name\",\n     \"reasoning\": \"Brief explanation of priority and routing\"\n   }\n\nAnalyze this ticket:\nTicket ID: {{382672799__ticket_id}}\nCustomer Name: {{382672799__customer_name}}\nCustomer Email: {{382672799__customer_email}}\nSubject: {{382672799__subject}}\nMessage: {{382672799__message}}\nCategory: {{382672799__category}}\nPlan: {{382672799__plan}}",
        "inputFields": {
          "ticket_id": "{{382672799__ticket_id}}",
          "customer_name": "{{382672799__customer_name}}",
          "customer_email": "{{382672799__customer_email}}",
          "subject": "{{382672799__subject}}",
          "message": "{{382672799__message}}",
          "category": "{{382672799__category}}",
          "plan": "{{382672799__plan}}"
        },
        "outputFields": [
          {
            "name": "category",
            "description": "Ticket category: billing, technical, account, or general"
          },
          {
            "name": "priority",
            "description": "Ticket priority: Urgent, High, Medium, or Low"
          },
          {
            "name": "assigned_team",
            "description": "Team assigned to handle this ticket"
          },
          {
            "name": "reasoning",
            "description": "Explanation for the priority and routing decision"
          }
        ],
        "isOutputArray": false,
        "includeWorkflowData": true,
        "model_id": "standard/auto"
      },
